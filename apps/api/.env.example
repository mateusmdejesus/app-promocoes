# Porta HTTP da API
PORT=3333
# Arquivo do banco SQLite (padrão: keropromo.db na pasta da API)
DATABASE_PATH=./keropromo.db
# Minutos entre cada varredura das lojas
MONITOR_INTERVAL_MIN=5
# Lojas ativas, separadas por vírgula: demo,mercadolivre
STORES=demo
# Token de acesso da API do Mercado Livre (developers.mercadolivre.com.br)
# Mercado Livre: App ID, Client Secret e refresh token (gerado pelo script ml:connect)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# --- Contas e assinatura ---
# Bundle id do app iOS, para conferir o "Entrar com Apple"
APPLE_BUNDLE_ID=app.keropromo
# Envio do código por e-mail (resend.com). Vazio = o código aparece no terminal.
RESEND_API_KEY=
EMAIL_FROM=keropromo <acesso@keropromo.app>
# Segredo configurado no webhook do RevenueCat (cabeçalho Authorization)
REVENUECAT_WEBHOOK_AUTH=
# 1 = libera /v1/dev/grant-pro para testar o Pro sem loja. NUNCA em produção.
ALLOW_DEV_PURCHASES=0

# --- Site e Pix ---
# Token de produção do Mercado Pago (Suas integrações → Credenciais)
MP_ACCESS_TOKEN=
# Endereço público desta API (para o Mercado Pago avisar pagamentos)
PUBLIC_URL=https://app-promocoes-production.up.railway.app
# Sites que podem chamar a API pelo navegador, separados por vírgula
WEB_ORIGINS=https://keropromo.com.br,http://localhost:3000
# Contas da casa (equipe/testes) que são sempre Pro, separadas por vírgula.
PRO_EMAILS=
